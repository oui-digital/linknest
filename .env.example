# Database (Neon Serverless Postgres)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Auth.js
AUTH_SECRET= # Generate with: npx auth secret
AUTH_URL=http://localhost:3000

# Canonical public origin. Used for metadataBase, OG tags, sitemap/robots URLs
# and the Stripe billing-portal return URL. Falls back to AUTH_URL, then to the
# Vercel production URL, then to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Daily reconciliation cron (see vercel.json → /api/cron/reconcile).
# Required in production: the route rejects any request without this bearer
# token. Generate with: openssl rand -hex 32
CRON_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Emailit (https://emailit.com — for magic link & verification emails)
EMAILIT_API_KEY=em_xxxxx
EMAIL_FROM="LinkNest <noreply@linknest.click>"

# Cloudflare R2 (https://dash.cloudflare.com → R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=linknest-assets
R2_PUBLIC_URL= # e.g. https://pub-xxx.r2.dev

# PostHog (https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY= # For server-side analytics queries (Settings → Personal API Keys)
POSTHOG_PROJECT_ID= # Numeric project ID from PostHog URL

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY= # sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET= # whsec_... (from Stripe Dashboard → Webhooks)
STRIPE_PRICE_MONTHLY= # price_... (Pro monthly price ID)
STRIPE_PRICE_YEARLY= # price_... (Pro yearly price ID)

# Google Safe Browsing (https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com)
GOOGLE_SAFE_BROWSING_API_KEY=

# Upstash Redis (https://console.upstash.com — for rate limiting)
# REQUIRED in production. If these are unset, every rate limiter is disabled
# (the app logs an error at startup but still serves traffic), which leaves
# password brute-force, magic-link mail-bombing and mutation flooding unthrottled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (https://sentry.io)
# The DSN is not a secret — it only permits sending events, not reading them.
# NEXT_PUBLIC_ is required for browser errors (inlined at BUILD time, so it must
# be set before `next build`, not just at runtime).
NEXT_PUBLIC_SENTRY_DSN= # https://xxx@yyy.ingest.sentry.io/zzz
SENTRY_DSN= # Optional: same value. Set it to keep server errors off a public var.
SENTRY_ORG= # Your Sentry org slug (for source map uploads)
SENTRY_PROJECT= # Your Sentry project slug
SENTRY_AUTH_TOKEN= # For source map uploads (optional — Settings → Auth Tokens)

# Moderation alerts (possible link farms, reports, takedowns).
# Optional: when unset, alerts are only written to the function logs.
ADMIN_ALERT_EMAIL=

# Admin moderation API (/api/admin/*). Bearer token; see README → Moderation.
# Unset = every admin request is refused. Generate with: openssl rand -hex 32
ADMIN_API_SECRET=

# Automatic takedown after reports from 3 distinct reporters (IPv4 address or
# IPv6 /64) within 24 hours, free pages only. Leave unset until the admin API
# and alerts have been exercised in production; reports are recorded and
# alerted either way.
MODERATION_AUTO_TAKEDOWN=

# Cloudflare Turnstile (report form now; signup forms too). Explicit switch:
# unset = off. When "true", SITE_KEY, SECRET_KEY and ALLOWED_HOSTNAMES must all
# be set or every protected form refuses submissions (fail closed).
# Use a production widget whose hostnames exclude localhost; set per Vercel
# environment. The site key reaches the browser through server props.
TURNSTILE_ENABLED=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES= # e.g. linknest.click,www.linknest.click
# Local dev only: Cloudflare's test keys (site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA; 2x…AA secret always fails) do
# not report the real action/hostname. TURNSTILE_TEST_MODE=true skips those two
# checks; it is ignored when VERCEL_ENV=production.
TURNSTILE_TEST_MODE=
